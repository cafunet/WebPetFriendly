@model IEnumerable<WebPetFriendly.Models.Medico>

@{
    ViewData["Title"] = "Index";
}

<h1>Medicos disponibles</h1>

<p>
    <a class="btn-small waves-effect waves-light green" asp-action="Create">Crear Medico</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cedula)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Direccion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.FechaNacimiento)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Genero)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Pais)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Departamento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ciudad)
            </th> *@
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cedula)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Apellido)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Direccion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            @* <td>
                @Html.DisplayFor(modelItem => item.FechaNacimiento)
            </td> *@
            <td>
                @Html.DisplayFor(modelItem => item.Genero)
            </td>
            @* <td>
                @Html.DisplayFor(modelItem => item.Pais)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Departamento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ciudad)
            </td> *@
            <td>
                <a class="btn-small waves-effect waves-light green" asp-action="Edit" asp-route-id="@item.IdMedico">Editar</a> |
                <a class="btn-small waves-effect waves-light blue" asp-action="Details" asp-route-id="@item.IdMedico">Detalles</a> |
                <a class="btn-small waves-effect waves-light red" asp-action="Delete" asp-route-id="@item.IdMedico">Borrar</a>
            </td>
        </tr>
}
    </tbody>
</table>
