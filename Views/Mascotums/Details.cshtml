@model WebPetFriendly.Models.Mascotum

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles de la mascota</h1>

<div>
    <h4>Mascotas:</h4>
    <hr />
    <ul class="collection">
        <li class="collection-item">
            <span class="title">Nombre:</span>
            @Html.DisplayFor(model => model.Nombre)
        </li>
        <li class="collection-item">
            <span class="title">Especie:</span>
            @Html.DisplayFor(model => model.Especie)
        </li>
        <li class="collection-item">
            <span class="title">Raza:</span>
            @Html.DisplayFor(model => model.Raza)
        </li>
        <li class="collection-item">
            <span class="title">Color:</span>
            @Html.DisplayFor(model => model.Color)
        </li>
        <li class="collection-item">
            <span class="title">Fecha de nacimiento:</span>
            @Html.DisplayFor(model => model.FechaNacimiento)
        </li>
        <li class="collection-item">
            <span class="title">Propietario:</span>
            @Html.DisplayFor(model => model.Propietario)
        </li>
    </ul>

    
</div>
<div>
    <a class="btn-small waves-effect waves-light blue" asp-action="Edit" asp-route-id="@Model?.IdMascota">Editar</a> |
    <a class="btn-small waves-effect waves-light grey" asp-action="Index">Regresar</a>
</div>
