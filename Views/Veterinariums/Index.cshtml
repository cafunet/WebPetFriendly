@model IEnumerable<WebPetFriendly.Models.Veterinarium>

@{
    ViewData["Title"] = "Index";
}

<h1>Peluditos registrados</h1>

<p>
    <a class="btn-small waves-effect waves-light green" asp-action="Create">Crear nuevo peludo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Direccion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Empleados)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.FechaFundacion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nit)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Direccion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            @* <td>
                @Html.DisplayFor(modelItem => item.Empleados)
            </td> *@
            <td>
                @Html.DisplayFor(modelItem => item.FechaFundacion)
            </td>
            <td>
                <a class="btn-small waves-effect waves-light green" asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a class="btn-small waves-effect waves-light blue" asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a class="btn-small waves-effect waves-light red" asp-action="Delete" asp-route-id="@item.Id">Borrar</a>
            </td>
        </tr>
}
    </tbody>
</table>
